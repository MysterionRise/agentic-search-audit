# Required for LLM judge evaluation (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Direct OpenAI access (alternative to OpenRouter)
# OPENAI_API_KEY=sk-your-key-here

# Optional: Anthropic API access
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# AUDIT_* / STRIPE_* / SENTRY_DSN are only read by the experimental SaaS layer (docs/SAAS.md)
